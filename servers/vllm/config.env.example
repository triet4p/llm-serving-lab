# vLLM server configuration
#
# Copy this file to `config.env` next to it and adjust the values for your
# GPU server. The runner (run.sh) sources `config.env` when present and falls
# back to these defaults otherwise. Shared values (MODEL_NAME) still come from
# configs/models.env and profiles/vllm.env first; this file overrides them.

# Model to serve. Keep it configurable rather than hard-coded into the runner
# (docs/04 §11). Must be a model name/identifier vLLM can load on the GPU.
MODEL_NAME=Qwen/Qwen3.5-2B

# Host to bind. Use 0.0.0.0 so the developer machine can reach the server
# over the network (docs/04 §12).
HOST=0.0.0.0

# Port for the OpenAI-compatible endpoint.
PORT=8000

# Tensor-parallel size: number of GPUs across which the model is sharded.
# Keep at 1 for a single-GPU demo; increase only when the GPU server has
# multiple GPUs and the model requires sharding.
TENSOR_PARALLEL_SIZE=1
