# Backend base URLs
#
# One OpenAI-compatible base URL (including the /v1 suffix) per serving
# backend. Profiles (profiles/*.env) select one of these to export as
# OPENAI_BASE_URL. Exact values are confirmed in later sprints when each
# server is implemented.

# Baseline FastAPI server (localhost, no GPU required)
BASELINE_BASE_URL=http://localhost:8080/v1

# vLLM server
VLLM_BASE_URL=http://localhost:8000/v1

# Ollama server
OLLAMA_BASE_URL=http://localhost:11434/v1
