# Backend base URLs
#
# One OpenAI-compatible base URL (including the /v1 suffix) per serving
# backend. All three backends run on the GPU server; these are the addresses
# the developer machine uses to reach them over the network. Adjust the IP if
# your server's address differs.

# Baseline FastAPI server (runs on the GPU server, same box as vLLM)
BASELINE_BASE_URL=http://192.168.30.244:8080/v1

# vLLM server (GPU server)
VLLM_BASE_URL=http://192.168.30.244:8000/v1

# Ollama server (same server box)
OLLAMA_BASE_URL=http://192.168.30.244:11434/v1
