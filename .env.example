# LLM Serving Lab - shared environment variables
#
# Copy this file to .env and adjust the values for your setup.
# These variables are the single configuration contract used by servers,
# clients, benchmarks, and scripts. They are backend-neutral: every serving
# backend in this repo exposes an OpenAI-compatible endpoint, so the same
# BASE_URL / API_KEY / MODEL_NAME drive all of them.

# Base URL of the OpenAI-compatible API (including the /v1 suffix).
# Switch between backends by pointing this at the right server, e.g.:
#   vLLM:    http://localhost:8000/v1
#   Ollama:  http://localhost:11434/v1
#   Baseline FastAPI: http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:8000/v1

# API key. Self-hosted backends usually accept any non-empty value (e.g. "demo").
OPENAI_API_KEY=demo

# Default model served by the selected backend. Must be configurable, not
# hard-coded, because each backend may expose a different model name.
MODEL_NAME=Qwen/Qwen3-8B
