# vLLM backend profile
#
# vLLM is the main optimized serving backend. It runs on the GPU server
# (192.168.30.244) and its OpenAI-compatible endpoint is exposed by
# `vllm serve`. OPENAI_BASE_URL below is the address the developer machine
# uses to reach it; adjust the IP if your GPU server's address differs.
OPENAI_BASE_URL=http://192.168.30.244:8000/v1
OPENAI_API_KEY=demo
MODEL_NAME=Qwen/Qwen3-8B
