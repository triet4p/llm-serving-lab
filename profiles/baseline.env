# Baseline FastAPI backend profile
#
# The hand-written FastAPI baseline loads the model with Hugging Face
# Transformers + torch, so it runs on the SAME GPU server as vLLM (not on the
# developer machine). OPENAI_BASE_URL below is the address the developer
# machine uses to reach it over the network; adjust the IP if your GPU
# server's address differs.
OPENAI_BASE_URL=http://192.168.30.244:8080/v1
OPENAI_API_KEY=demo
MODEL_NAME=Qwen/Qwen3-8B
