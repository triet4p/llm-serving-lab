# Ollama backend profile
#
# Ollama uses short model tags (unlike the HF-style names used by the
# baseline and vLLM profiles). It runs on the same server box; OPENAI_BASE_URL
# below is the address the developer machine uses to reach it. Adjust the IP
# if your server's address differs.
OPENAI_BASE_URL=http://192.168.30.244:11434/v1
OPENAI_API_KEY=demo
MODEL_NAME=qwen3:8b
